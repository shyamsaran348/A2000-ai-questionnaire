# A2000 Environment Configuration

# 1. Database (PostgreSQL - Neon Serverless / Supabase)
DATABASE_URL="postgres://username:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# 2. Email Service (Resend)
RESEND_API_KEY="re_sample_123456789"
EMAIL_FROM="A2000 Enablement <discovery@a2000.ai>"

# 3. Application URL (used for generating magic links)
NEXT_PUBLIC_APP_URL="https://a2000-questionnaire.vercel.app"

# 4. Auth.js / NextAuth Secret
AUTH_SECRET="generate-a-secure-32-byte-hex-string-for-session-encryption"
