# A2000 production settings. Lives at ~/a2000/.env.production on the server (never in Git).
# Keep values in double quotes. Re-run deploy.sh after changing anything here.

# Public address of the site, used in invitation links. No trailing slash.
NEXT_PUBLIC_APP_URL="https://assessments.a2000india.com"

# Database. Either keep the current Neon database (copy the value from Vercel),
# or leave it to setup-server.sh --with-postgres, which fills in a local one.
DATABASE_URL=""

# Email (current Gmail account). Copy the values from Vercel > Settings > Environment Variables.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
NOTIFICATION_EMAIL="a2000aiteam@gmail.com"

# Optional: send from a company mailbox instead of Gmail (recommended).
# Filled in = used instead of Gmail. SMTP_PASS is a Zoho app password. Guide: docs/ubuntu-server-setup.md
# SMTP_HOST="smtppro.zoho.in"   # if sign-in fails, try smtp.zoho.in
# SMTP_PORT="465"
# SMTP_USER="assessments@a2000india.com"
# SMTP_PASS=""
# MAIL_FROM_NAME="A2000 AI Enablement"
# MAIL_REPLY_TO="a2000aiteam@gmail.com"

# Optional: also upload nightly database backups to this S3 bucket (needs the AWS CLI and an IAM role).
# BACKUP_S3_BUCKET=""
